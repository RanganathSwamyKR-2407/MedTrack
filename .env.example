# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (sqlite | postgres)
DB_DRIVER=sqlite
DB_PATH=./data/medtrack.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/medtrack

# Security & Authentication (Set strong random secrets in production)
JWT_SECRET=
JWT_EXPIRES_IN=12h
OTP_HMAC_SECRET=

# OTP & Door Access Policy
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
UNLOCK_TOKEN_TTL_SECONDS=60

# Temperature Monitoring & Cooling Policy (Celsius)
TEMP_MIN_C=4.0
TEMP_MAX_C=8.0
TEMP_HYSTERESIS_C=0.5
TEMP_STALE_SECONDS=60
GPS_STALE_SECONDS=90
DEVICE_OFFLINE_SECONDS=120

# Hardware Simulation Mode (set false in production)
SIMULATION_MODE=true
